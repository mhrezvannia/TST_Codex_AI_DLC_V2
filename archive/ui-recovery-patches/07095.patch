+        actions={
+          <Link className="erp-btn erp-btn--primary" href="/bookings/new">
+            <LucideIcon name="plus" size={16} />
+            New booking
+          </Link>
+        }
+      />
+
+      <form method="get" aria-label="Booking filters">
+        <FilterToolbar>
+          <label className="booking-filter booking-filter--search">
