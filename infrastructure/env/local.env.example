# Local development values only.
# Staging and production descriptors must reference Vault paths.

POSTGRES_USER=linercore
POSTGRES_PASSWORD=linercore_local
LOCAL_RUNTIME_MODE=local
LOCAL_RUNTIME_PROFILE=core
AUTH_BYPASS=false
REFERENCE_DATA_AUTH_BYPASS=false
HOST_RUNTIME=false
LOCAL_PROXY_PORT=8088
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
SCHEMA_REGISTRY_PORT=8081
KAFKA_PORT=9092
IDENTITY_SERVICE_PORT=8082
REFERENCE_DATA_SERVICE_PORT=8083
AUTH_APP_PORT=3000
REFERENCE_DATA_APP_PORT=3001
CHARGE_AGREEMENTS_APP_PORT=3002
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=linercore-local
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8080
KEYCLOAK_CALLBACK_URL=http://127.0.0.1:8088/auth/callback
JWT_ISSUER_URI=http://keycloak:8080/realms/linercore-local
AUTH_CLIENT_ID=linercore-auth
AUTH_AUDIENCE=linercore-shared-platform
IDENTITY_SERVICE_CLIENT_ID=linercore-identity-service
REFERENCE_DATA_SERVICE_CLIENT_ID=linercore-reference-data-service
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
NGINX_HEALTH_URL=http://nginx/health
AUTH_APP_URL=http://127.0.0.1:3000
REFERENCE_DATA_APP_URL=http://127.0.0.1:3001
CHARGE_AGREEMENTS_APP_URL=http://127.0.0.1:3002
SEED_WAIT_TIMEOUT_MS=60000
SEED_PACK_PATH=/workspace/infrastructure/seeds/shared-platform-mvp-defaults.json
