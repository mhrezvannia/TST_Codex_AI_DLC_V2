# Isolated Wave A runtime. These values deliberately avoid the manager demo.
LINERCORE_COMPOSE_PROJECT=linercore-wave-a
LINERCORE_NETWORK_NAME=linercore-wave-a-network
LINERCORE_IMAGE_TAG=wave-a

POSTGRES_HOST_PORT=127.0.0.1:65432
KEYCLOAK_HOST_PORT=127.0.0.1:18080
KAFKA_HOST_PORT=127.0.0.1:19092
SCHEMA_REGISTRY_HOST_PORT=127.0.0.1:18081
IDENTITY_SERVICE_HOST_PORT=127.0.0.1:18082
REFERENCE_DATA_SERVICE_HOST_PORT=127.0.0.1:18083
CHARGE_AGREEMENT_SERVICE_HOST_PORT=127.0.0.1:18084
BOOKING_SERVICE_HOST_PORT=127.0.0.1:18085
CONTAINER_MOVEMENT_SERVICE_HOST_PORT=127.0.0.1:18086

SHELL_APP_HOST_PORT=127.0.0.1:18104
REFERENCE_DATA_UI_HOST_PORT=127.0.0.1:18102
BOOKING_APP_HOST_PORT=127.0.0.1:18101
NGINX_HOST_PORT=127.0.0.1:18088

# U01 Rate authority is fail-closed in Wave A. Values are local-only examples;
# deployments must inject separate non-local secrets.
AUTH_RUNTIME_PROFILE=local
CHARGE_RATE_AUTHORIZATION_MODE=identity-http
CHARGE_IDENTITY_SERVICE_ID=charge-agreement-service
CHARGE_IDENTITY_SERVICE_TOKEN=charge_identity_wave_a_local_token
CHARGE_REFERENCE_SERVICE_ID=charge-agreement-service
CHARGE_REFERENCE_SERVICE_TOKEN=reference_data_charge_wave_a_local_token
REFERENCE_DATA_CHARGE_TOKEN=reference_data_charge_wave_a_local_token
CHARGE_SERVICE_TOKEN=charge_bff_wave_a_local_token
CHARGE_PRICING_SERVICE_ID=booking-service
CHARGE_PRICING_SERVICE_TOKEN=pricing_booking_wave_a_local_token
BOOKING_CHARGE_SERVICE_ID=booking-service
BOOKING_CHARGE_SERVICE_TOKEN=pricing_booking_wave_a_local_token
CHARGE_AGREEMENT_OUTBOX_RELAY_ENABLED=false
AUTH_SESSION_SECRET=linercore-wave-a-session-secret
CHARGE_PUBLIC_ORIGINS=http://127.0.0.1:18088
CHARGE_BFF_ASSERTION_SECRET=linercore-wave-a-assertion-secret
CHARGE_BFF_ASSERTION_KID=w2-03-wave-a-v1
CHARGE_BFF_ASSERTION_REPLAY_CAPACITY=4096
CHARGE_BFF_PROTECTED_PERMITS=20
CHARGE_BFF_REFERENCE_PERMITS=10
CHARGE_BFF_PERMIT_WAIT_MS=100
CHARGE_BFF_DEADLINE_MS=2500
CHARGE_REFERENCE_DEADLINE_MS=2000
CHARGE_BFF_EGRESS_DEADLINE_MS=5000
CHARGE_BFF_REQUEST_BODY_BYTES=32768
CHARGE_BFF_RESPONSE_BYTES=524288
CHARGE_REFERENCE_RESPONSE_BYTES=131072

AUTH_REDIRECT_URI=http://127.0.0.1:18088/auth/api/auth/callback
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:18088
SHELL_PUBLIC_URL=http://127.0.0.1:18088
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:18080
JWT_ISSUER_URI=http://127.0.0.1:18080/realms/linercore-local

PROMETHEUS_HOST_PORT=127.0.0.1:19090
GRAFANA_HOST_PORT=127.0.0.1:23003
JAEGER_UI_HOST_PORT=127.0.0.1:26686
JAEGER_OTLP_GRPC_HOST_PORT=127.0.0.1:24317
JAEGER_OTLP_HTTP_HOST_PORT=127.0.0.1:24318
OTEL_GRPC_HOST_PORT=127.0.0.1:24319
OTEL_HTTP_HOST_PORT=127.0.0.1:24320
ELASTICSEARCH_HOST_PORT=127.0.0.1:29200
KIBANA_HOST_PORT=127.0.0.1:25601
