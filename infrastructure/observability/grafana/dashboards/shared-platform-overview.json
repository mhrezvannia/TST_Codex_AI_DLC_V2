{
  "title": "Shared Platform Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Reference API latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{service=\"reference-data-service\"}[5m])) by (le))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox pending depth",
      "targets": [
        {
          "expr": "reference_outbox_pending_total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Event freshness p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(reference_event_freshness_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Booking API latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"booking-service\"}[5m])) by (le))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Booking outbox pending",
      "targets": [
        {
          "expr": "booking_outbox_pending_total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CMM status relay pending",
      "targets": [
        {
          "expr": "containermovement_outbox_pending_total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Charge pricing request failures",
      "targets": [
        {
          "expr": "increase(http_server_requests_seconds_count{job=\"charge-agreement-service\", outcome=\"SERVER_ERROR\"}[5m])"
        }
      ]
    }
  ]
}
