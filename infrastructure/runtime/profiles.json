{
  "profiles": [
    {
      "name": "core",
      "description": "PostgreSQL, Keycloak, Kafka, Schema Registry, and shared network.",
      "readinessState": "infrastructure_ready",
      "services": ["postgres", "keycloak", "kafka", "schema-registry"]
    },
    {
      "name": "app",
      "description": "Implemented backend services, frontends, reverse proxy, seed loader, and contract hooks.",
      "readinessState": "application_ready",
      "services": ["postgres", "keycloak", "kafka", "schema-registry", "identity-service", "reference-data-service", "apps-auth", "apps-reference-data", "nginx", "seed-loader"]
    },
    {
      "name": "observability",
      "description": "Prometheus, Grafana, Jaeger, OpenTelemetry Collector, Elasticsearch, and Kibana.",
      "readinessState": "infrastructure_ready",
      "services": ["prometheus", "grafana", "jaeger", "otel-collector", "elasticsearch", "kibana"]
    },
    {
      "name": "devtools",
      "description": "Optional developer inspection tools and contract catalog helpers.",
      "readinessState": "infrastructure_ready",
      "services": ["postgres", "keycloak", "kafka", "schema-registry", "contract-devtools"]
    },
    {
      "name": "full",
      "description": "All implemented local runtime profiles with honest missing-unit reporting.",
      "readinessState": "evidence_ready",
      "services": ["postgres", "keycloak", "kafka", "schema-registry", "identity-service", "reference-data-service", "apps-auth", "apps-reference-data", "nginx", "seed-loader", "contract-devtools", "prometheus", "grafana", "jaeger", "otel-collector", "elasticsearch", "kibana"]
    }
  ],
  "ideModes": [
    {
      "targetService": "identity-service",
      "hostPort": 8082,
      "containerDependencies": ["postgres", "keycloak"],
      "envOverrides": ["HOST_RUNTIME=true", "IDENTITY_SERVICE_URL=http://127.0.0.1:8082"],
      "statusReportingMode": "host_run_service"
    },
    {
      "targetService": "reference-data-service",
      "hostPort": 8083,
      "containerDependencies": ["postgres", "kafka", "schema-registry"],
      "envOverrides": ["HOST_RUNTIME=true", "REFERENCE_DATA_SERVICE_URL=http://127.0.0.1:8083"],
      "statusReportingMode": "host_run_service"
    },
    {
      "targetService": "apps-reference-data",
      "hostPort": 3001,
      "containerDependencies": ["identity-service", "reference-data-service"],
      "envOverrides": ["HOST_RUNTIME=true", "REFERENCE_DATA_APP_URL=http://127.0.0.1:3001"],
      "statusReportingMode": "host_run_frontend"
    }
  ],
  "serviceIdentities": [
    {
      "serviceName": "identity-service",
      "clientId": "linercore-identity-service",
      "audience": "linercore-shared-platform",
      "issuer": "http://keycloak:8080/realms/linercore-local",
      "capabilities": ["identity-roles:read", "identity-audit:read", "platform-status:read"]
    },
    {
      "serviceName": "reference-data-service",
      "clientId": "linercore-reference-data-service",
      "audience": "linercore-shared-platform",
      "issuer": "http://keycloak:8080/realms/linercore-local",
      "capabilities": ["reference-data:read", "reference-data:create", "reference-data:update", "platform-status:read"]
    }
  ],
  "ports": [
    { "serviceName": "postgres", "hostPort": 5432, "containerPort": 5432, "requiredProfiles": ["core", "app", "devtools", "full"] },
    { "serviceName": "keycloak", "hostPort": 8080, "containerPort": 8080, "requiredProfiles": ["core", "app", "devtools", "full"] },
    { "serviceName": "schema-registry", "hostPort": 8081, "containerPort": 8081, "requiredProfiles": ["core", "app", "devtools", "full"] },
    { "serviceName": "kafka", "hostPort": 9092, "containerPort": 9092, "requiredProfiles": ["core", "app", "devtools", "full"] },
    { "serviceName": "identity-service", "hostPort": 8082, "containerPort": 8082, "requiredProfiles": ["app", "full"] },
    { "serviceName": "reference-data-service", "hostPort": 8083, "containerPort": 8083, "requiredProfiles": ["app", "full"] },
    { "serviceName": "nginx", "hostPort": 8088, "containerPort": 80, "requiredProfiles": ["app", "full"] },
    { "serviceName": "grafana", "hostPort": 3001, "containerPort": 3000, "requiredProfiles": ["observability", "full"] }
  ]
}
