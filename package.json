{
  "name": "linercore-shared-platform",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "backend:build": "mvn -f services/pom.xml -DskipTests package",
    "backend:test": "mvn -f services/pom.xml test",
    "local:check": "node scripts/check-local-prereqs.mjs",
    "local:check:json": "node scripts/check-local-prereqs.mjs --json",
    "local:runtime": "node scripts/local-runtime.mjs",
    "seed:local": "node scripts/seed-local.mjs --seed-file infrastructure/seeds/shared-platform-mvp-defaults.json",
    "seed:validate": "node scripts/seed-local.mjs --dry-run --seed-file infrastructure/seeds/shared-platform-mvp-defaults.json",
    "contracts:validate": "node scripts/validate-contract-catalog.mjs",
    "contracts:verify": "node scripts/verify-contract-providers.mjs",
    "contracts:verify:live": "node scripts/verify-contract-providers.mjs --live --evidence-file artifacts/contracts-live-verification.json",
    "readiness:local": "node scripts/local-readiness.mjs --evidence artifacts/readiness/local-readiness.json",
    "quality:gates": "node scripts/run-quality-gates.mjs --all --evidence artifacts/quality-gates/evidence.json",
    "w1:replay-restart": "node scripts/replay-restart-proof.mjs --evidence artifacts/w1-01-live/replay-restart/evidence.json",
    "w1:replay-restart:dry-run": "node scripts/replay-restart-proof.mjs --dry-run --evidence artifacts/w1-01-live/replay-restart/evidence.json",
    "w1:live-acceptance": "node scripts/w1-live-acceptance.mjs",
    "w1:live-acceptance:dry-run": "node scripts/w1-live-acceptance.mjs --dry-run",
    "w2-01:live-acceptance": "node scripts/w2-01-live-acceptance.mjs",
    "w2-01:live-acceptance:dry-run": "node scripts/w2-01-live-acceptance.mjs --dry-run",
    "w2-01:live-acceptance:validate": "node scripts/w2-01-live-acceptance.mjs --validate",
    "w2-04:live-acceptance": "node scripts/w2-04-live-acceptance.mjs --evidence-file artifacts/w2-04-live/acceptance.json",
    "w2-04:playwright": "node scripts/w2-04-playwright.mjs --output-root artifacts/w2-04-live/playwright",
    "demo:guard": "node scripts/demo-guard.mjs",
    "demo:lock": "node scripts/demo-image-lock.mjs",
    "demo:seed-wave-a": "node scripts/demo-image-lock.mjs --seed-wave-a",
    "wave-a:config": "node scripts/wave-a-compose.mjs config",
    "wave-a:ps": "node scripts/wave-a-compose.mjs ps",
    "wave-a:up": "node scripts/wave-a-compose.mjs up -d --no-build",
    "wave-a:stop": "node scripts/wave-a-compose.mjs stop",
    "wave-a:clean": "node scripts/wave-a-compose.mjs down --volumes --remove-orphans",
    "u02:preservation": "node scripts/u02-route-preservation.mjs",
    "u02:preservation:test": "node scripts/u02-route-preservation.test.mjs",
    "u02:performance": "node scripts/u02-bff-performance.mjs --input artifacts/u02/performance.json",
    "u02:performance:test": "node scripts/u02-bff-performance.test.mjs",
    "u02:security": "node scripts/run-u02-security-gates.mjs",
    "u03:preservation": "node scripts/u03-agreement-preservation.mjs",
    "u03:preservation:test": "node scripts/u03-agreement-preservation.test.mjs",
    "u03:performance": "node scripts/u03-agreement-performance.mjs --evidence artifacts/u03/performance.json",
    "u03:performance:test": "node scripts/u03-agreement-performance.test.mjs",
    "u03:e2e": "playwright test tests/e2e/u03-agreement-authority.spec.ts",
    "u04:preservation": "node scripts/u04-pricing-preservation.mjs",
    "u04:preservation:test": "node scripts/u04-pricing-preservation.test.mjs",
    "u04:performance": "node scripts/u04-pricing-performance.mjs --evidence artifacts/u04/performance.json",
    "u04:performance:test": "node scripts/u04-pricing-performance.test.mjs",
    "u04:rollback:test": "node scripts/u04-rollback-policy.test.mjs",
    "skeleton:validate": "node scripts/validate-skeleton.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:observability": "node scripts/smoke-observability.mjs",
    "w2-02:anti-drift": "node scripts/check-w2-02-presentation.mjs",
    "w2-02:test:scripts": "node --test --test-isolation=none scripts/check-w2-02-presentation.test.mjs scripts/w2-02-acceptance-guard.test.mjs scripts/w2-02-evidence.test.mjs scripts/w2-02-fixture-contract.test.mjs scripts/w2-02-live-acceptance.test.mjs scripts/w2-02-pricing-fixture.test.mjs scripts/w2-02-trace-sanitize.test.mjs scripts/w2-02-ui-proof.test.mjs scripts/w2-02-workspace-identity.test.mjs",
    "w2-02:test:auth-state": "bun test scripts/w2-02-storage-state.test.ts",
    "w2-02:test:focused": "corepack yarn workspace @erp/ui test && corepack yarn workspace @erp/app-shell test && corepack yarn workspace @erp/app-booking test && corepack yarn w2-02:test:scripts && corepack yarn w2-02:test:auth-state",
    "w2-02:playwright": "playwright test --config playwright.config.ts",
    "w2-02:storage-state": "bun scripts/w2-02-storage-state.ts",
    "w2-02:live-acceptance": "node scripts/w2-02-live-acceptance.mjs",
    "w2-02:evidence:validate": "node scripts/w2-02-evidence.mjs",
    "w2-02:trace:sanitize": "node scripts/w2-02-trace-sanitize-cli.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "fflate": "0.8.2",
    "jsdom": "^25.0.1",
    "playwright-core": "1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
