{
  "name": "linercore-shared-platform",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "backend:build": "mvn -f services/pom.xml -DskipTests package",
    "backend:test": "mvn -f services/pom.xml test",
    "local:check": "node scripts/check-local-prereqs.mjs",
    "local:check:json": "node scripts/check-local-prereqs.mjs --json",
    "local:runtime": "node scripts/local-runtime.mjs",
    "seed:local": "node scripts/seed-local.mjs --seed-file infrastructure/seeds/shared-platform-mvp-defaults.json",
    "seed:validate": "node scripts/seed-local.mjs --dry-run --seed-file infrastructure/seeds/shared-platform-mvp-defaults.json",
    "contracts:validate": "node scripts/validate-contract-catalog.mjs",
    "contracts:verify": "node scripts/verify-contract-providers.mjs",
    "contracts:verify:live": "node scripts/verify-contract-providers.mjs --live --evidence-file artifacts/contracts-live-verification.json",
    "readiness:local": "node scripts/local-readiness.mjs --evidence artifacts/readiness/local-readiness.json",
    "quality:gates": "node scripts/run-quality-gates.mjs --all --evidence artifacts/quality-gates/evidence.json",
    "skeleton:validate": "node scripts/validate-skeleton.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:observability": "node scripts/smoke-observability.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
