{
  "type": "record",
  "name": "BookingConfirmed",
  "namespace": "com.linercore.booking.events",
  "doc": "Canonical Booking confirmation event consumed by Container Movement Management.",
  "fields": [
    { "name": "id", "type": "string" },
    { "name": "source", "type": "string" },
    { "name": "type", "type": "string" },
    { "name": "time", "type": "string" },
    { "name": "correlationId", "type": "string" },
    { "name": "dataSchemaVersion", "type": "int" },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "BookingConfirmedData",
        "fields": [
          { "name": "bookingId", "type": "string" },
          { "name": "bookingRevision", "type": "int" },
          {
            "name": "routing",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "BookingConfirmedRoutingLeg",
                "fields": [
                  { "name": "legSequence", "type": "int" },
                  { "name": "loadUnLocode", "type": "string" },
                  { "name": "dischargeUnLocode", "type": "string" },
                  { "name": "voyageId", "type": "string" }
                ]
              }
            }
          },
          {
            "name": "equipment",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "BookingConfirmedEquipmentAssignment",
                "fields": [
                  { "name": "equipmentTypeCode", "type": "string" },
                  { "name": "quantity", "type": "int" },
                  { "name": "equipmentId", "type": ["null", "string"], "default": null }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
